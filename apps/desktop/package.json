{
  "name": "budgie-social",
  "productName": "Budgie",
  "version": "1.3.0",
  "description": "Budgie for Windows and Linux: small, friendly communities, chats and calls",
  "homepage": "https://budgiesocial.com",
  "author": {
    "name": "teofilcelzmecher",
    "email": "217388809+teofilcelzmecher@users.noreply.github.com",
    "url": "https://github.com/teofilcelzmecher"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "main.js",
  "desktopName": "budgie-social.desktop",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "icons": "node tools/make-icons.js",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.budgiesocial.app",
    "productName": "Budgie",
    "copyright": "Copyright © 2026 teofilcelzmecher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "activity.js",
      "pages-preload.js",
      "desktop.js",
      "strings.js",
      "pages/**",
      "icons/**",
      "LICENSE",
      "package.json"
    ],
    "electronLanguages": [
      "en-US",
      "en-GB",
      "ro",
      "es",
      "fr",
      "de",
      "it"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Budgie-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Budgie",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Network;InstantMessaging;Chat",
      "executableName": "budgie-social",
      "synopsis": "Small, friendly communities, chats and calls",
      "description": "Budgie: small, friendly communities called nests, with posts, chats and voice and video calls.",
      "maintainer": "teofilcelzmecher <217388809+teofilcelzmecher@users.noreply.github.com>",
      "vendor": "Budgie",
      "desktop": {
        "entry": {
          "Name": "Budgie",
          "GenericName": "Communities, chats and calls",
          "Comment": "Small, friendly communities, chats and calls",
          "Keywords": "chat;call;community;messages;friends;budgiesocial;",
          "StartupWMClass": "Budgie"
        }
      },
      "artifactName": "budgie-social-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "Budgie-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "budgie-social-${arch}.deb"
    },
    "rpm": {
      "artifactName": "budgie-social-${arch}.rpm",
      "depends": [
        "(gtk3 or libgtk-3-0)",
        "(nss or mozilla-nss)",
        "(alsa-lib or libasound2)",
        "(libnotify or libnotify4)",
        "(libXScrnSaver or libXss1)",
        "(libXtst or libXtst6)",
        "(at-spi2-core or libatspi0)",
        "(libuuid or libuuid1)",
        "(libsecret or libsecret-1-0)",
        "xdg-utils"
      ]
    },
    "pacman": {
      "artifactName": "budgie-social-${arch}.pacman",
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libxss",
        "libxtst",
        "libnotify",
        "at-spi2-core",
        "util-linux-libs",
        "libsecret",
        "xdg-utils"
      ]
    },
    "publish": null
  }
}
